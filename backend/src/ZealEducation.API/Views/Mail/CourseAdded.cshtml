@model CourseAddedEmailModel
@{
    ViewData["Title"] = "New course enrollment";
    ViewData["HeaderSubtitle"] = "New course enrollment";

    string FormatAmount(decimal value) => $"{value.ToString("N0", CultureInfo.InvariantCulture)} VND";
    string FormatDate(DateOnly date) => date.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
}
<p style="margin:0 0 16px;">Hi <strong>@Model.RecipientName</strong>,</p>
<p style="margin:0 0 16px;">You have been enrolled in a new course. Below are the course and tuition details.</p>

<h2 style="margin:24px 0 8px;font-size:16px;color:@MailTheme.Primary;border-bottom:1px solid @MailTheme.Border;padding-bottom:6px;">Course details</h2>
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;">
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;width:40%;">Course</td>
        <td style="padding:6px 0;"><strong>@Model.CourseName</strong></td>
    </tr>
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;">Duration</td>
        <td style="padding:6px 0;">@Model.DurationWeeks weeks</td>
    </tr>
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;">Candidate code</td>
        <td style="padding:6px 0;font-family:Consolas,monospace;">@Model.CandidateCode</td>
    </tr>
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;">Enrollment date</td>
        <td style="padding:6px 0;">@FormatDate(Model.EnrollmentDate)</td>
    </tr>
</table>

<h2 style="margin:24px 0 8px;font-size:16px;color:@MailTheme.Primary;border-bottom:1px solid @MailTheme.Border;padding-bottom:6px;">Tuition fee</h2>
<p style="margin:0 0 8px;">Total tuition for this course: <strong>@FormatAmount(Model.BaseFee)</strong></p>
<p style="margin:0 0 16px;color:@MailTheme.MutedFg;">You may choose either of the payment options below. Please contact our support team to confirm your selection.</p>

<h3 style="margin:20px 0 8px;font-size:15px;color:@MailTheme.FgColor;">Option A &mdash; Lump-sum payment</h3>
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;border:1px solid @MailTheme.Border;border-radius:6px;overflow:hidden;">
    <thead>
        <tr style="background:@MailTheme.Primary;color:@MailTheme.PrimaryFg;">
            <th align="left" style="padding:10px 12px;font-weight:600;">Description</th>
            <th align="right" style="padding:10px 12px;font-weight:600;">Amount</th>
        </tr>
    </thead>
    <tbody>
        <tr style="background:@MailTheme.Card;">
            <td style="padding:10px 12px;border-top:1px solid @MailTheme.Border;">Full tuition (one-time payment)</td>
            <td align="right" style="padding:10px 12px;border-top:1px solid @MailTheme.Border;"><strong>@FormatAmount(Model.LumpSumAmount)</strong></td>
        </tr>
    </tbody>
</table>

<h3 style="margin:24px 0 8px;font-size:15px;color:@MailTheme.FgColor;">Option B &mdash; Installment plans</h3>
@if (Model.InstallmentOptions.Count == 0)
{
    <p style="margin:0;color:@MailTheme.MutedFg;">Installment plans are not available for this course duration.</p>
}
else
{
    foreach (var option in Model.InstallmentOptions)
    {
        <p style="margin:16px 0 6px;font-weight:600;">@option.Frequency plan &mdash; @option.Items.Count installments</p>
        <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;border:1px solid @MailTheme.Border;border-radius:6px;overflow:hidden;">
            <thead>
                <tr style="background:@MailTheme.Primary;color:@MailTheme.PrimaryFg;">
                    <th align="left" style="padding:10px 12px;font-weight:600;width:15%;">#</th>
                    <th align="right" style="padding:10px 12px;font-weight:600;">Amount</th>
                    <th align="right" style="padding:10px 12px;font-weight:600;">Due date</th>
                </tr>
            </thead>
            <tbody>
                @{ var rowIndex = 0; }
                @foreach (var item in option.Items)
                {
                    var rowBg = rowIndex % 2 == 0 ? MailTheme.Card : MailTheme.Muted;
                    rowIndex++;
                    <tr style="background:@rowBg;">
                        <td style="padding:10px 12px;border-top:1px solid @MailTheme.Border;">@item.InstallmentNo</td>
                        <td align="right" style="padding:10px 12px;border-top:1px solid @MailTheme.Border;">@FormatAmount(item.AmountDue)</td>
                        <td align="right" style="padding:10px 12px;border-top:1px solid @MailTheme.Border;">@FormatDate(item.DueDate)</td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

<p style="margin:32px 0 0;color:@MailTheme.MutedFg;font-size:13px;">If you have any questions, please contact our support team.</p>
