@{
    var headerSubtitle = ViewData["HeaderSubtitle"] as string;
    var pageTitle = ViewData["Title"] as string ?? "Zeal Education";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@pageTitle</title>
</head>
<body style="margin:0;padding:24px;background:@MailTheme.BgColor;color:@MailTheme.FgColor;font-family:-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;font-size:14px;line-height:1.5;">
    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="max-width:640px;margin:0 auto;background:@MailTheme.Card;border:1px solid @MailTheme.Border;border-radius:10px;overflow:hidden;">
        <tr>
            <td style="background:@MailTheme.Primary;color:@MailTheme.PrimaryFg;padding:20px 24px;">
                <h1 style="margin:0;font-size:20px;font-weight:600;">Zeal Education</h1>
                @if (!string.IsNullOrWhiteSpace(headerSubtitle))
                {
                    <p style="margin:4px 0 0;font-size:13px;opacity:0.85;">@headerSubtitle</p>
                }
            </td>
        </tr>
        <tr>
            <td style="padding:24px;">
                @RenderBody()
            </td>
        </tr>
        <tr>
            <td style="background:@MailTheme.Muted;color:@MailTheme.MutedFg;padding:14px 24px;font-size:12px;text-align:center;border-top:1px solid @MailTheme.Border;">
                &copy; Zeal Education
            </td>
        </tr>
    </table>
</body>
</html>
