@model CandidatePasswordResetEmailModel
@{
    ViewData["Title"] = "Password reset";
    ViewData["HeaderSubtitle"] = "Account password reset";
}
<p style="margin:0 0 16px;">Hi <strong>@Model.RecipientName</strong>,</p>
<p style="margin:0 0 16px;">Your account password has just been reset by an administrator. Please use the temporary password below to sign in and set a new password immediately.</p>

<h2 style="margin:24px 0 8px;font-size:16px;color:@MailTheme.Primary;border-bottom:1px solid @MailTheme.Border;padding-bottom:6px;">Account details</h2>
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;">
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;width:40%;">Candidate code</td>
        <td style="padding:6px 0;font-family:Consolas,monospace;">@Model.CandidateCode</td>
    </tr>
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;">Reset at</td>
        <td style="padding:6px 0;">@Model.ResetAt.ToString("dd MMM yyyy HH:mm 'UTC'", CultureInfo.InvariantCulture)</td>
    </tr>
</table>

<h2 style="margin:24px 0 8px;font-size:16px;color:@MailTheme.Primary;border-bottom:1px solid @MailTheme.Border;padding-bottom:6px;">New login credentials</h2>
<div style="background:@MailTheme.Muted;border:1px solid @MailTheme.Border;border-radius:8px;padding:16px;">
    <p style="margin:0 0 8px;"><span style="color:@MailTheme.MutedFg;">Username:</span> <strong style="font-family:Consolas,monospace;">@Model.Username</strong></p>
    <p style="margin:0 0 8px;"><span style="color:@MailTheme.MutedFg;">Temporary password:</span> <strong style="font-family:Consolas,monospace;">@Model.TemporaryPassword</strong></p>
    <p style="margin:0;color:@MailTheme.MutedFg;font-size:13px;">You must change this password the first time you sign in.</p>
</div>

<p style="margin:24px 0 0;color:@MailTheme.MutedFg;font-size:13px;">If you did not request this change, please contact our support team immediately.</p>
