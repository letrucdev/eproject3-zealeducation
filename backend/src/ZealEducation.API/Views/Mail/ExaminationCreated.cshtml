@model ExaminationCreatedEmailModel
@{
    ViewData["Title"] = "Exam scheduled";
    ViewData["HeaderSubtitle"] = "Exam scheduled";

    string FormatDate(DateOnly date) => date.ToString("dd MMM yyyy", CultureInfo.InvariantCulture);
}
<p style="margin:0 0 16px;">Hi <strong>@Model.RecipientName</strong>,</p>
<p style="margin:0 0 16px;">A new exam has been scheduled for your batch. Please review the details below.</p>

<h2 style="margin:24px 0 8px;font-size:16px;color:@MailTheme.Primary;border-bottom:1px solid @MailTheme.Border;padding-bottom:6px;">Exam details</h2>
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;">
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;width:40%;">Exam name</td>
        <td style="padding:6px 0;"><strong>@Model.ExamName</strong></td>
    </tr>
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;">Date</td>
        <td style="padding:6px 0;">@FormatDate(Model.ExamDate)</td>
    </tr>
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;">Location</td>
        <td style="padding:6px 0;">@(string.IsNullOrWhiteSpace(Model.Location) ? "-" : Model.Location)</td>
    </tr>
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;">Max score</td>
        <td style="padding:6px 0;">@Model.MaxScore</td>
    </tr>
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;">Pass score</td>
        <td style="padding:6px 0;">@Model.PassScore</td>
    </tr>
</table>

<h2 style="margin:24px 0 8px;font-size:16px;color:@MailTheme.Primary;border-bottom:1px solid @MailTheme.Border;padding-bottom:6px;">Batch</h2>
<table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse:collapse;">
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;width:40%;">Batch code</td>
        <td style="padding:6px 0;font-family:Consolas,monospace;">@Model.BatchCode</td>
    </tr>
    <tr>
        <td style="padding:6px 0;color:@MailTheme.MutedFg;">Course</td>
        <td style="padding:6px 0;">@Model.CourseName</td>
    </tr>
</table>

<p style="margin:32px 0 0;color:@MailTheme.MutedFg;font-size:13px;">Please make sure to be available on the exam date. Contact your instructor or the program coordinator if you have any concerns.</p>
