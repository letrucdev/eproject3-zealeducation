# Copy to .env and adjust as needed. docker-compose reads this automatically.

# --- Database ---
MSSQL_SA_PASSWORD=Zeal_StrongPass!2026

# --- Backend (JWT) ---
JWT_SECRET_KEY=ZealEducation-Super-Secret-Key-Change-Me-In-Production-0123456789

# --- CORS / Frontend origin allowed by the API ---
FRONTEND_ORIGIN=http://localhost:8080

# --- Frontend build args (baked into the Angular bundle) ---
FRONTEND_API_URL=http://localhost:5085/api
APP_NAME=Zeal Education

# --- Cloudflare R2 (leave blank if not using uploads) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- SMTP (defaults to bundled mailhog) ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=noreply@zealeducation.local
SMTP_FROM_NAME=Zeal Education
